# 비타망고 — local build + store upload with reusable release notes.
#
# No EAS cloud build (free): each lane runs `expo prebuild` to generate the
# native project, builds it locally, then uploads the binary + release notes.
# Release notes come from ../release-notes.json (per-version, else `default`).
#
# Auth: App Store Connect API key (.p8) for iOS, a Play service-account JSON for
# Android — both via env vars (see fastlane/README.md). Nothing secret is
# committed.

require "json"
require "fileutils"

APP_JSON   = File.expand_path("../app.json", __dir__)
NOTES_JSON = File.expand_path("../release-notes.json", __dir__)
APP_DIR    = File.expand_path("..", __dir__)
APP_IDENTIFIER = "com.vitamango.app"
APP_NAME = "비타망고"
APP_SKU = "vita-mango-ios"

def app_json
  JSON.parse(File.read(APP_JSON))
end

def app_version
  app_json["expo"]["version"]
end

# Release note for a locale, for the current app.json version (falls back to the
# generic `default` block).
def notes_for(locale)
  data  = JSON.parse(File.read(NOTES_JSON))
  entry = data[app_version] || data["default"]
  entry[locale] || data["default"][locale]
end

# Bump the native build number (iOS) and versionCode (Android) in app.json.
# app.json is the version source of truth (eas.json appVersionSource=local), and
# `expo prebuild --clean` regenerates the native projects from it each run — so
# the bump must live here, not in the generated ios/android files.
def bump_ios_build!
  data    = app_json
  ios     = (data["expo"]["ios"] ||= {})
  ios["buildNumber"]     = ((ios["buildNumber"] || "0").to_i + 1).to_s
  File.write(APP_JSON, JSON.pretty_generate(data) + "\n")
  UI.success("Bumped → iOS build #{ios['buildNumber']} (v#{app_version})")
end

def bump_android_build!
  data    = app_json
  android = (data["expo"]["android"] ||= {})
  android["versionCode"] = (android["versionCode"] || 0).to_i + 1
  File.write(APP_JSON, JSON.pretty_generate(data) + "\n")
  UI.success("Bumped → Android versionCode #{android['versionCode']} (v#{app_version})")
end

# App Review contact info.
#
# Apple has no appStoreReviewDetail record for a brand-new app until it is saved
# once. deliver's `review_attachment_file` calls `fetch_app_store_review_detail`
# WITHOUT a rescue (upload_metadata.rb:751), so a missing record blows up the
# whole upload with a bare `[!] No data (RuntimeError)`. `review_information`
# runs just before it and *creates* the record when we pass this hash — so
# always pass it.
REVIEW_NOTES = <<~NOTES.strip
  RESPONSE TO GUIDELINE 1.4.1 (build 18 rejection: health information without
  citations). This build adds citations with working links throughout the app.

  WHERE TO FIND THE CITATIONS
  1. Bottom tab "마이" (rightmost, mango icon) -> the "📚 근거 및 출처"
     ("Evidence and Sources") card, directly under the three stat tiles and
     visible without scrolling. It opens a full citations screen containing:
       - the institutions consulted, each an openable link
       - the definition of the A/B/C evidence grades
       - every one of the 53 ingredients with its own source link
       - the date the links were last checked
  2. Tab "맞춤추천" (Recommendations) -> each recommendation card ends with a
     "📚 이 성분의 출처" ("Sources for this ingredient") section linking that
     specific ingredient's reference.
  3. Every screen (홈 / 기록 / 맞춤추천 / 마이 and the survey result) carries a
     disclaimer block with a "📚 근거 및 출처 보기" link into the same screen.

  All links open in Safari via the system URL handler. Sources are the Korean
  Ministry of Food and Drug Safety notice on functional ingredients (National
  Law Information Center), the MFDS functional-ingredient database, the Korean
  Dietary Reference Intakes (Ministry of Health and Welfare), the Australian
  Institute of Sport supplement framework, the International Society of Sports
  Nutrition, NIH MedlinePlus and NIH NCCIH. Every URL was opened and verified
  before shipping.

  IMPORTANT ON THE EVIDENCE GRADES: the A/B/C grades are this app's own
  classification, informed by the sources above. They are not any institution's
  official rating, and the app states this explicitly on the citations screen.
  The grades only weight the ranking; they are not efficacy claims.

  ELEVEN INGREDIENTS (e.g. taurine, propolis, maca) have no dedicated fact sheet
  at any of these institutions. Rather than invent a citation, those cards say so
  and link to the MFDS functional-ingredient database instead.

  NOTE ON iPad: the app is iPhone-only (supportsTablet is false), so on an iPad
  it runs in iPhone compatibility mode and shows the same layout as on iPhone.
  The build was installed and launched on an iPad Air 11-inch simulator to
  confirm it runs correctly there.

  GENERAL: No account or demo credentials are needed. On first launch the app
  opens the adaptive survey; completing or skipping it leads directly to the
  full app. Supplements, dose history, diary entries, survey answers, and Jelly
  growth stay on the device and can be deleted from My Page.

  Supplement suggestions are computed deterministically on device from bundled
  general-wellness reference data. They do not diagnose or prescribe. The app
  tells users who are pregnant, taking medication, or managing a condition to
  consult a qualified professional.
NOTES

def app_review_information_hash
  info = {
    first_name: ENV["ASC_REVIEW_FIRST_NAME"],
    last_name: ENV["ASC_REVIEW_LAST_NAME"],
    phone_number: ENV["ASC_REVIEW_PHONE"],
    email_address: ENV["ASC_REVIEW_EMAIL"],
    notes: ENV["ASC_REVIEW_NOTES"] || REVIEW_NOTES
  }
  missing = info.reject { |k, _| k == :notes }.select { |_, v| v.to_s.strip.empty? }.keys
  unless missing.empty?
    UI.user_error!(
      "App Review \uC5F0\uB77D\uCC98\uAC00 \uBE44\uC5B4 \uC788\uC2B5\uB2C8\uB2E4 (#{missing.join(', ')}). " \
      "app/.env \uC5D0 ASC_REVIEW_FIRST_NAME / ASC_REVIEW_LAST_NAME / " \
      "ASC_REVIEW_PHONE / ASC_REVIEW_EMAIL \uB97C \uCC44\uC6B0\uACE0 \uB2E4\uC2DC \uC2E4\uD589\uD558\uC138\uC694."
    )
  end
  info
end

# Resolve ASC_KEY_PATH to an ABSOLUTE path (xcodebuild rejects relative ones),
# trying it as-is and relative to the app dir / repo root.
def asc_key_path
  raw = ENV.fetch("ASC_KEY_PATH")
  # File.expand_path always returns an absolute path; try a few bases and pick
  # the first that actually exists (handles ASC_KEY_PATH set as a relative path).
  [
    File.expand_path(raw),
    File.expand_path(raw, APP_DIR),
    File.expand_path(raw, File.dirname(APP_DIR)),
  ].find { |p| File.exist?(p) } || File.expand_path(raw)
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: asc_key_path
  )
end

def apple_team_id
  ENV.fetch("APPLE_TEAM_ID")
end

def ensure_connect_app!(api_key)
  # app_store_connect_api_key configures Spaceship's Connect API token.
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  return app if app

  UI.user_error!(
    "No App Store Connect app exists for #{APP_IDENTIFIER}. " \
    "Apple does not allow API-key clients to create the initial app record; " \
    "create it once in App Store Connect and rerun this lane."
  )
end

# xcodebuild flags that let it create/download the signing profile + cert
# non-interactively using the App Store Connect API key (no Xcode login needed).
def provisioning_xcargs
  [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath #{asc_key_path.shellescape}",
    "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
    "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
  ].join(" ")
end

def prebuild(platform)
  # --clean regenerates the native project from app.json (applies the bumped
  # build number, bundle id, plugin config). --no-install skips prebuild's own
  # pod/npm step; iOS runs `pod install` explicitly below so failures surface
  # loudly instead of silently leaving no .xcworkspace.
  sh("cd #{APP_DIR.shellescape} && npx expo prebuild -p #{platform} --clean --no-install")
end

platform :ios do
  desc "Local build → upload to TestFlight with release notes"
  lane :beta do
    # The withDevelopmentTeam config plugin stamps DEVELOPMENT_TEAM from this env
    # var during prebuild, so signing has a team to work with. Force it (a stale
    # app/.env value must not win — it's what caused the team mismatch).
    bump_ios_build!
    prebuild("ios")
    cocoapods(podfile: File.join(APP_DIR, "ios", "Podfile")) # → creates .xcworkspace
    workspace = Dir[File.join(APP_DIR, "ios", "*.xcworkspace")].first
    UI.user_error!("No .xcworkspace found — pod install failed?") unless workspace

    key = asc_api_key
    ensure_connect_app!(key)
    # Create/fetch an Apple Distribution certificate (installed to the keychain)
    # and an App Store provisioning profile via the API key. NOTE: the ASC API
    # key must have the ADMIN role to create these — App Manager can't.
    cert(api_key: key, output_path: File.join(APP_DIR, "build", "certs"))
    sigh(
      api_key: key,
      app_identifier: APP_IDENTIFIER,
      output_path: File.join(APP_DIR, "build", "profiles")
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    # prebuild leaves the target on development signing ("iPhone Developer") —
    # force manual App Store signing with the distribution profile above.
    update_code_signing_settings(
      path: File.join(APP_DIR, "ios", "app.xcodeproj"),
      use_automatic_signing: false,
      team_id: apple_team_id,
      bundle_identifier: APP_IDENTIFIER,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_app(
      workspace: workspace,
      scheme: File.basename(workspace, ".xcworkspace"),
      export_method: "app-store",
      output_directory: File.join(APP_DIR, "build"),
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_IDENTIFIER => profile_name }
      }
    )
    upload_to_testflight(
      api_key: key,
      changelog: notes_for("ko"),
      skip_waiting_for_build_processing: true
    )
    UI.success("Uploaded to TestFlight. Promote to the App Store in App Store Connect when ready.")
  end


  desc "One command after initial ASC app creation: local archive → upload → submit for App Review"
  lane :production do
    key = asc_api_key
    ensure_connect_app!(key)
    bump_ios_build!
    prebuild("ios")
    cocoapods(podfile: File.join(APP_DIR, "ios", "Podfile"))
    workspace = Dir[File.join(APP_DIR, "ios", "*.xcworkspace")].first
    UI.user_error!("No .xcworkspace found — pod install failed?") unless workspace

    cert(api_key: key, output_path: File.join(APP_DIR, "build", "certs"))
    sigh(
      api_key: key,
      app_identifier: APP_IDENTIFIER,
      output_path: File.join(APP_DIR, "build", "profiles")
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: File.join(APP_DIR, "ios", "app.xcodeproj"),
      use_automatic_signing: false,
      team_id: apple_team_id,
      bundle_identifier: APP_IDENTIFIER,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    ipa_path = build_app(
      workspace: workspace,
      scheme: File.basename(workspace, ".xcworkspace"),
      export_method: "app-store",
      output_directory: File.join(APP_DIR, "build"),
      output_name: "vita-mango.ipa",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_IDENTIFIER => profile_name }
      }
    )

    upload_to_app_store(
      api_key: key,
      app_identifier: APP_IDENTIFIER,
      app_version: app_version,
      ipa: ipa_path,
      skip_metadata: false,
      metadata_path: File.join(APP_DIR, "fastlane", "metadata"),
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      app_review_information: app_review_information_hash,
      submission_information: {
        add_id_info_uses_idfa: true,
        add_id_info_serves_ads: true,
        add_id_info_tracks_action: false,
        add_id_info_tracks_install: false,
        add_id_info_limits_tracking: true,
        export_compliance_uses_encryption: false
      }
    )
    UI.success("Uploaded v#{app_version} and requested App Review (manual release after approval).")
  end

  desc "Submit the already-uploaded current iOS build for App Review"
  lane :submit do
    key = asc_api_key
    ensure_connect_app!(key)
    build_number = app_json.dig("expo", "ios", "buildNumber")
    UI.user_error!("No iOS build number in app.json") if build_number.to_s.strip.empty?

    upload_to_app_store(
      api_key: key,
      app_identifier: APP_IDENTIFIER,
      app_version: app_version,
      build_number: build_number,
      skip_binary_upload: true,
      skip_metadata: false,
      metadata_path: File.join(APP_DIR, "fastlane", "metadata"),
      skip_screenshots: false,
      screenshots_path: File.join(APP_DIR, "fastlane", "screenshots"),
      overwrite_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      app_review_information: app_review_information_hash,
      submission_information: {
        add_id_info_uses_idfa: true,
        add_id_info_serves_ads: true,
        add_id_info_tracks_action: false,
        add_id_info_tracks_install: false,
        add_id_info_limits_tracking: true,
        export_compliance_uses_encryption: false
      }
    )
    UI.success("Submitted v#{app_version} (build #{build_number}) for App Review with manual release after approval.")
  end

  desc "Replace App Store screenshots and resubmit the same build for review"
  lane :screenshots do
    key = asc_api_key
    ensure_connect_app!(key)
    build_number = app_json.dig("expo", "ios", "buildNumber")
    sh("cd #{APP_DIR.shellescape} && bundle exec ruby scripts/replace-ios-store-screenshots.rb")
    upload_to_app_store(
      api_key: key,
      app_identifier: APP_IDENTIFIER,
      app_version: app_version,
      build_number: build_number,
      skip_binary_upload: true,
      skip_metadata: false,
      metadata_path: File.join(APP_DIR, "fastlane", "metadata"),
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      app_review_information: app_review_information_hash,
      submission_information: {
        add_id_info_uses_idfa: true,
        add_id_info_serves_ads: true,
        add_id_info_tracks_action: false,
        add_id_info_tracks_install: false,
        add_id_info_limits_tracking: true,
        export_compliance_uses_encryption: false
      }
    )
    UI.success("Replaced App Store screenshots and resubmitted v#{app_version} (build #{build_number}) for review.")
  end

  desc "Resubmit the current iOS build without modifying screenshots"
  lane :resubmit do
    key = asc_api_key
    ensure_connect_app!(key)
    build_number = app_json.dig("expo", "ios", "buildNumber")
    UI.user_error!("No iOS build number in app.json") if build_number.to_s.strip.empty?

    upload_to_app_store(
      api_key: key,
      app_identifier: APP_IDENTIFIER,
      app_version: app_version,
      build_number: build_number,
      skip_binary_upload: true,
      skip_metadata: false,
      metadata_path: File.join(APP_DIR, "fastlane", "metadata"),
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      app_review_information: app_review_information_hash,
      submission_information: {
        add_id_info_uses_idfa: true,
        add_id_info_serves_ads: true,
        add_id_info_tracks_action: false,
        add_id_info_tracks_install: false,
        add_id_info_limits_tracking: true,
        export_compliance_uses_encryption: false
      }
    )
    UI.success("Resubmitted v#{app_version} (build #{build_number}) without changing screenshots.")
  end

  desc "Upload the already-built .ipa to TestFlight (no rebuild)"
  lane :upload do
    candidates = ["vita-mango.ipa", "app.ipa"].map { |n| File.join(APP_DIR, "build", n) }
    ipa = candidates.find { |path| File.exist?(path) }
    UI.user_error!("No .ipa in #{File.join(APP_DIR, 'build')} — run `fastlane ios beta` first") unless ipa
    UI.message("Uploading #{File.basename(ipa)}")
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: ipa,
      changelog: notes_for("ko"),
      skip_waiting_for_build_processing: true
    )
    UI.success("Uploaded to TestFlight.")
  end
end

platform :android do
  desc "Local build → upload to Play internal track with release notes"
  lane :beta do
    bump_android_build!
    prebuild("android")

    # Write changelogs where supply reads them (metadata/android/<locale>/changelogs/<versionCode>.txt).
    version_code = app_json["expo"]["android"]["versionCode"]
    { "ko-KR" => notes_for("ko"), "en-US" => notes_for("en-US") }.each do |loc, text|
      dir = File.expand_path("metadata/android/#{loc}/changelogs", __dir__)
      FileUtils.mkdir_p(dir)
      File.write(File.join(dir, "#{version_code}.txt"), text)
    end

    gradle(
      project_dir: File.join(APP_DIR, "android"),
      task: "bundle",
      build_type: "Release"
    )
    upload_to_play_store(
      track: "internal",
      aab: File.join(APP_DIR, "android/app/build/outputs/bundle/release/app-release.aab"),
      json_key: ENV.fetch("PLAY_JSON_KEY_PATH"),
      skip_upload_apk: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
    UI.success("Uploaded to Play internal track. Promote to production in the Play Console when ready.")
  end


  desc "One command: local Android bundle → upload to Play production"
  lane :production do
    bump_android_build!
    prebuild("android")
    gradle(
      project_dir: File.join(APP_DIR, "android"),
      task: "bundle",
      build_type: "Release"
    )
    upload_to_play_store(
      track: "production",
      aab: File.join(APP_DIR, "android/app/build/outputs/bundle/release/app-release.aab"),
      json_key: ENV.fetch("PLAY_JSON_KEY_PATH"),
      skip_upload_apk: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
