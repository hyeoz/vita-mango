# App Store Connect / signing only. The app itself has no runtime environment
# variables, account provider, or backend URL.
# Keep the real .p8 file under app/secrets/; both this .env file and
# app/secrets are gitignored.
APPLE_TEAM_ID=XXXXXXXXXX
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
ASC_APP_ID=xxxxxxxxxx

# App Review 연락처 (fastlane 이 이 값으로 심사 정보 레코드를 생성/갱신)
ASC_REVIEW_FIRST_NAME=
ASC_REVIEW_LAST_NAME=
ASC_REVIEW_PHONE=
ASC_REVIEW_EMAIL=
