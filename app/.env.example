# Google OAuth Web client ID — used by @react-native-google-signin to mint the
# idToken that Firebase Auth exchanges for a session.
#
# Where to find it: Firebase Console → Authentication → Sign-in method → Google →
# "Web SDK configuration" → Web client ID  (it ends in .apps.googleusercontent.com)
#
# Copy this file to app/.env and fill it in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Backend (Claude proxy) base URL. Defaults to localhost:4000 / 10.0.2.2:4000.
# On a physical device, set your machine's LAN address:
# EXPO_PUBLIC_API_URL=http://192.168.0.10:4000

# App Store Connect API key. Keep the real .p8 file under app/secrets/; both
# this .env file and app/secrets are gitignored.
APPLE_TEAM_ID=XXXXXXXXXX
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
ASC_APP_ID=xxxxxxxxxx
