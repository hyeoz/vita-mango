<?xml version="1.0" encoding="UTF-8"?>
<!--
  iOS Firebase config. Do NOT edit by hand — download the real file from
  Firebase Console → Project settings → Your iOS app (bundle com.jelly.supplement)
  → GoogleService-Info.plist, then save it next to this file as
  'GoogleService-Info.plist'. The keys below only show the expected shape.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CLIENT_ID</key>
  <string>000000000000-xxxxxxxx.apps.googleusercontent.com</string>
  <key>REVERSED_CLIENT_ID</key>
  <string>com.googleusercontent.apps.000000000000-xxxxxxxx</string>
  <key>API_KEY</key>
  <string>REPLACE_WITH_REAL_KEY</string>
  <key>GCM_SENDER_ID</key>
  <string>000000000000</string>
  <key>BUNDLE_ID</key>
  <string>com.jelly.supplement</string>
  <key>PROJECT_ID</key>
  <string>your-firebase-project-id</string>
  <key>STORAGE_BUCKET</key>
  <string>your-firebase-project-id.appspot.com</string>
  <key>GOOGLE_APP_ID</key>
  <string>1:000000000000:ios:0000000000000000</string>
</dict>
</plist>
