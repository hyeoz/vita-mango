# Copy to .env and fill in. The key stays server-side; the mobile app never sees it.
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# Optional: override the Gemini model (default gemini-2.5-flash)
# GEMINI_MODEL=gemini-flash-latest
# Optional: override the port the proxy listens on (default 4000)
# PORT=4000
