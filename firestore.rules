rules_version = '2';

// Each user can read and write ONLY their own document. No cross-user access.
// The subscription fields (`subscribed`, `subscriptionExpiresAt`) are
// server-controlled: the client may READ them but never write them. They are
// set by the backend (Admin SDK, which bypasses these rules) after a verified
// purchase — otherwise a user could self-grant an ad-free subscription.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if isOwner(uid);
      // On create, the client must not include subscription fields at all.
      allow create: if isOwner(uid) && !hasSubscriptionFields(request.resource.data);
      // On update, the subscription fields must be left untouched.
      allow update: if isOwner(uid) && !subscriptionChanged();
      // Account deletion removes the signed-in user's own document before the
      // Firebase Auth account is deleted.
      allow delete: if isOwner(uid);
    }
    // everything else is denied by default
  }

  function isOwner(uid) {
    return request.auth != null && request.auth.uid == uid;
  }

  function hasSubscriptionFields(data) {
    return data.keys().hasAny(['subscribed', 'subscriptionExpiresAt']);
  }

  function subscriptionChanged() {
    return request.resource.data.diff(resource.data)
      .affectedKeys()
      .hasAny(['subscribed', 'subscriptionExpiresAt']);
  }
}
